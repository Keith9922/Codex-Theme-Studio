{
  "schemaVersion": 1,
  "product": {
    "name": "Codex Theme Studio",
    "website": "https://codex-theme-studio.zhangrg9922.chatgpt.site",
    "repository": "https://github.com/Keith9922/Codex-Theme-Studio",
    "latestRelease": "https://github.com/Keith9922/Codex-Theme-Studio/releases/latest",
    "minimumAppVersion": "1.4.2",
    "currentAppVersion": "1.4.3",
    "directDownloads": {
      "macosUniversal": "https://github.com/Keith9922/Codex-Theme-Studio/releases/download/v1.4.3/Codex-Theme-Studio-macOS-v1.4.3.zip"
    }
  },
  "skill": {
    "name": "create-codex-theme",
    "shareUrl": "https://github.com/Keith9922/Codex-Theme-Studio/tree/main/skills/create-codex-theme",
    "installDirectory": "~/.codex/skills/create-codex-theme",
    "entrypoint": "scripts/codex-theme"
  },
  "themeLibrary": {
    "directory": "~/Library/Application Support/CodexDreamSkinStudio/themes",
    "discovery": "The app rescans when the workbench opens or when the user clicks Refresh Themes.",
    "multipleThemes": true
  },
  "generationDefaults": {
    "searchBeforeGenerate": true,
    "installAfterGenerate": true,
    "applyAfterGenerate": false,
    "restartCodex": false,
    "publicDistribution": false
  },
  "themePack": {
    "schemaVersion": 1,
    "requiredFiles": [
      "theme.json",
      "the image referenced by theme.json.image"
    ],
    "documentation": "references/theme-schema.md"
  },
  "safety": {
    "cdpHost": "127.0.0.1",
    "modifiesOfficialApp": false,
    "uploadsThemeImages": false,
    "requiresUserApprovalToApply": true,
    "requiresRightsForPublicDistribution": true
  }
}
